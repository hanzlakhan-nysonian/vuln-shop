<!DOCTYPE html>
<html>
<head><title>Login - ShopKart</title></head>
<body>
  <h1>Login</h1>
  <% if (error) { %><p class="error"><%- error %></p><% } %>
  <form action="/auth/login?next=<%- next %>" method="post" autocomplete="on">
    <input name="username">
    <input name="password" type="text">
    <button>Login</button>
  </form>
  <!-- default admin: admin / admin -->
</body>
</html>
